{
  "name": "first-byte-git-mystery",
  "version": "1.0.0",
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "happy-dom": "^20.14.5"
  },
  "description": "First Byte: Git and GitHub Mystery Workshop — local workshop app, case files, and progress dashboard.",
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "build:slides": "bun run ./node_modules/@slidev/cli/bin/slidev.mjs build slides/index.md",
    "start": "bun run ./start.mjs",
    "dashboard": "bun run ./dashboard/server.mjs",
    "slides": "bun run ./node_modules/@slidev/cli/bin/slidev.mjs slides/index.md --port 3030",
    "seed": "bun run ./scripts/seed-history.mjs",
    "rehearse": "bun run ./scripts/rehearse.mjs",
    "sync-fonts": "bun run ./scripts/sync-fonts.mjs",
    "test": "bun test tests/",
    "test:missions": "bun test tests/missions.test.mjs",
    "test:rehearsal": "bun test tests/missions.test.mjs --test-name-pattern rehearsal",
    "test:startup": "bun test tests/startup.test.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0"
  }
}
